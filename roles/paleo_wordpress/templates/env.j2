# Values consumed by docker-compose.yml on the VM.
# Regenerated every time the playbook runs; do not edit by hand.

# No PALEO_HOST_IP/PORT: the backend publishes no host ports (the reverse proxy
# does). PALEO_HOST is still the vhost name and the WordPress site URL.
PALEO_HOST="{{ paleo_host_name }}"

PALEO_FIRST_SITE_TITLE="{{ paleo_first_site_title }}"
PALEO_FIRST_USER_NAME="{{ paleo_first_user_name }}"
PALEO_FIRST_USER_EMAIL="{{ paleo_first_user_email }}"
PALEO_FIRST_USER_PASSWORD="{{ paleo_first_user_password }}"

MARIADB_PASSWORD={{ paleo_mariadb_password }}
MARIADB_ROOT_PASSWORD={{ paleo_mariadb_root_password }}
