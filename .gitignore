.vagrant
*.swp
*.retry
venv*/

# Local-only working docs (project.md, reverse-proxy.md, archive/) — not published.
docs/

# Operator TLS material dropped into the reverse proxy — never commit
# (keys/certs the network team supplies). Keep the directory via .gitkeep only.
docker/proxy/import-certificates/*
!docker/proxy/import-certificates/.gitkeep

# Production host_vars must be vaulted before being committed.
# Uncomment the next line if your workflow keeps them outside git entirely.
# environments/production/host_vars/*
